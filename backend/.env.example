# Base de données
MONGO_URL=mongodb://localhost:27017
DB_NAME=racontelle

# Sessions (JWT_SECRET : 64 caractères minimum)
JWT_SECRET=
JWT_ISSUER=racontelle-care
JWT_AUDIENCE=racontelle-care-app
ACCESS_MINUTES=15
REFRESH_DAYS=30

# CORS : origine exacte de l'application web
CORS_ORIGINS=
CORS_PROXY_ORIGIN=
CORS_PUBLIC_ORIGIN=

# Stockage audio (Emergent Managed Object Storage)
INTEGRATION_PROXY_URL=
EMERGENT_LLM_KEY=

# Traitement vocal Azure AI Speech — données traitées en France Central
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=francecentral

# Envoi des codes « Mot de passe oublié » (à configurer lors de l'intégration Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@racontelle.fr
