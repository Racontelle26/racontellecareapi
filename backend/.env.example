# Base de données
MONGO_URL=mongodb://localhost:27017
DB_NAME=racontelle

# Sessions (JWT_SECRET : 64 caractères minimum)
JWT_SECRET=
JWT_ISSUER=racontelle-care
JWT_AUDIENCE=racontelle-care-app
ACCESS_MINUTES=15
REFRESH_DAYS=30

# CORS : origine exacte de l'application web
CORS_ORIGINS=https://app.racontellecare.com
CORS_PROXY_ORIGIN=
CORS_PUBLIC_ORIGIN=

# Stockage audio S3 compatible (prioritaire dès que S3_BUCKET est renseigné)
# Scaleway Paris : S3_ENDPOINT=https://s3.fr-par.scw.cloud, S3_REGION=fr-par
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Ancien stockage audio (Emergent Managed Object Storage), utilisé sans S3_BUCKET
INTEGRATION_PROXY_URL=
EMERGENT_LLM_KEY=

# Traitement vocal Azure AI Speech — données traitées en France Central
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=francecentral

# Emails transactionnels Resend (backend uniquement, domaine vérifié)
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@racontellecare.com
PASSWORD_RESET_URL=https://app.racontellecare.com
