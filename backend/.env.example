# Base de données
MONGO_URL=mongodb://localhost:27017
DB_NAME=racontelle

# Sessions (JWT_SECRET : 64 caractères minimum)
JWT_SECRET=
JWT_ISSUER=racontelle-care
JWT_AUDIENCE=racontelle-care-app
ACCESS_MINUTES=15
REFRESH_DAYS=30

# CORS : origine exacte de l'application web
CORS_ORIGINS=
CORS_PROXY_ORIGIN=
CORS_PUBLIC_ORIGIN=

# Stockage audio et IA (Emergent)
INTEGRATION_PROXY_URL=
EMERGENT_LLM_KEY=

# Envoi des codes « Mot de passe oublié » (facultatif : sans SMTP, aucun email ne part)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@racontelle.fr
