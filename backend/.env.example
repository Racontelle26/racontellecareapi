# Copiez ce fichier en .env (local) ou saisissez ces variables dans Render.
# Ne publiez jamais le vrai fichier .env.

# --- Base de données (MongoDB Atlas, région Europe) ---
MONGO_URL=mongodb+srv://racontelle:MOT_DE_PASSE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=racontelle

# --- Sécurité ---
# 32 caractères minimum. Générez-en un : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Jeton des routes d'administration (export CSV, questions, suppressions). 24 caractères minimum.
ADMIN_TOKEN=
# Heure d'envoi de l'e-mail « question du jour » (heure de Paris)
DAILY_EMAIL_HOUR=9
# Origines web autorisées (version web de l'app). "*" accepte tout.
ALLOWED_ORIGINS=*

# --- URL publique de l'API ---
APP_PUBLIC_URL=https://api.racontelle.fr

# --- Stockage audio/photos (Cloudflare R2 ou tout service compatible S3) ---
S3_BUCKET=racontelle-souvenirs
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- E-mails (Resend, domaine vérifié) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=bonjour@racontelle.fr
EMAIL_FROM_NAME=Racontelle

# --- IA ---
# Livre romancé (Claude)
ANTHROPIC_API_KEY=
BOOK_MODEL=claude-sonnet-5
# Transcription automatique (Whisper). Laisser vide = saisie manuelle du texte.
OPENAI_API_KEY=

# --- Mode Emergent (optionnel, ancien hébergement) ---
# INTEGRATION_PROXY_URL=
# EMERGENT_LLM_KEY=
# EMERGENT_EMAIL_KEY=
