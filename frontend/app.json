{
  "expo": {
    "name": "Racontelle Family",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.familystories.ubz2aq",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Enregistrer vos souvenirs de famille à voix haute",
        "NSPhotoLibraryUsageDescription": "Illustrer vos souvenirs avec vos photos",
        "NSCameraUsageDescription": "Prendre une photo pour illustrer un souvenir"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FDFBF7"
      },
      "package": "com.emergent.familystories.ubz2aq",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDFBF7"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Enregistrer vos souvenirs de famille à voix haute"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Illustrer vos souvenirs avec vos photos",
          "cameraPermission": "Prendre une photo pour illustrer un souvenir"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
