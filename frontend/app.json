{
  "expo": {
    "name": "Racontelle Famille",
    "slug": "racontelle-famille",
    "owner": "laracontelle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "racontelle",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.racontelle.famille",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Enregistrer vos souvenirs de famille à voix haute",
        "NSPhotoLibraryUsageDescription": "Illustrer vos souvenirs avec vos photos",
        "NSCameraUsageDescription": "Prendre une photo pour illustrer un souvenir"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "fr.racontelle.famille",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/racontelle-logo.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Enregistrer vos souvenirs de famille à voix haute"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Illustrer vos souvenirs avec vos photos",
          "cameraPermission": "Prendre une photo pour illustrer un souvenir"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2162840c-ab22-4025-a9df-c8e19325d929"
      }
    }
  }
}
